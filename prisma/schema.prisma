// â”€â”€â”€ Live Classroom: Ø§Ù„Ù…Ø­Ø§Ø¶Ø±Ø§Øª Ø§Ù„Ù…Ø¨Ø§Ø´Ø±Ø© Ø¹Ø¨Ø± LiveKit â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

enum LiveLectureStatus {
  SCHEDULED
  LIVE
  ENDED
  CANCELLED
}

model LiveLecture {
  id          String            @id @default(uuid()) @db.Uuid
  courseId    String            @map("course_id") @db.Uuid
  teacherId   String            @map("teacher_id") @db.Uuid
  title       String
  description String?
  scheduledAt DateTime          @map("scheduled_at")
  startedAt   DateTime?         @map("started_at")
  endedAt     DateTime?         @map("ended_at")
  status      LiveLectureStatus @default(SCHEDULED)
  roomName    String            @unique @map("room_name")
  isDeleted   Boolean           @default(false) @map("is_deleted")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  course      Course                  @relation(fields: [courseId], references: [id])
  teacher     TeacherProfile          @relation(fields: [teacherId], references: [id])
  attendances LiveLectureAttendance[]

  @@index([courseId])
  @@index([teacherId])
  @@index([status])
  @@index([scheduledAt])
  @@map("live_lectures")
}

model LiveLectureAttendance {
  id              String    @id @default(uuid()) @db.Uuid
  lectureId       String    @map("lecture_id") @db.Uuid
  studentId       String    @map("student_id") @db.Uuid
  joinedAt        DateTime  @default(now()) @map("joined_at")
  lastJoinedAt    DateTime  @default(now()) @map("last_joined_at")
  leftAt          DateTime? @map("left_at")
  durationSeconds Int       @default(0) @map("duration_seconds")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  lecture LiveLecture    @relation(fields: [lectureId], references: [id], onDelete: Cascade)
  student StudentProfile @relation(fields: [studentId], references: [id])

  @@unique([lectureId, studentId])
  @@index([studentId])
  @@map("live_lecture_attendances")
}

// =================== Adhkar & Duas: أذكار وأدعية ===================

enum AdhkarCategory {
  MORNING
  EVENING
}

enum DuaSubCategory {
  EXAM
  STUDY
  GENERAL
  RELIEF
  POST_EXAM
  POST_LECTURE
}

model AdhkarItem {
  id          String         @id @default(uuid()) @db.Uuid
  code        String         @unique
  category    AdhkarCategory
  arabicText  String         @map("arabic_text") @db.Text
  repeatCount Int            @default(1) @map("repeat_count")
  source      String
  sortOrder   Int            @default(0) @map("sort_order")
  isDeleted   Boolean        @default(false) @map("is_deleted")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  dismissals AdhkarDismissal[]

  @@index([category, sortOrder])
  @@map("adhkar_items")
}

model DuaItem {
  id              String         @id @default(uuid()) @db.Uuid
  code            String         @unique
  subCategory     DuaSubCategory @default(GENERAL) @map("sub_category")
  arabicText      String         @map("arabic_text") @db.Text
  translationNote String?        @map("translation_note")
  source          String
  sortOrder       Int            @default(0) @map("sort_order")
  isDeleted       Boolean        @default(false) @map("is_deleted")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  @@index([subCategory, sortOrder])
  @@map("dua_items")
}

model AdhkarDismissal {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  itemId      String   @map("item_id") @db.Uuid
  dismissedAt DateTime @default(now()) @map("dismissed_at")
  reappearsAt DateTime @map("reappears_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  item AdhkarItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([userId, itemId])
  @@index([userId, reappearsAt])
  @@map("adhkar_dismissals")
}

// =================== Coins & Avatars: العملات والأفاتار ===================

enum CoinTxType {
  EARN_EXAM
  EARN_QUIZ
  EARN_HOMEWORK
  EARN_LESSON
  SPEND_AVATAR
  SPEND_FRAME
}

model StudentCoin {
  id        String   @id @default(uuid()) @db.Uuid
  studentId String   @unique @map("student_id") @db.Uuid
  balance   Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  student      StudentProfile     @relation(fields: [studentId], references: [id], onDelete: Cascade, map: "fk_coin_student")
  transactions CoinTransaction[]  @relation("CoinTxCoin")

  @@map("student_coins")
}

model CoinTransaction {
  id          String     @id @default(uuid()) @db.Uuid
  studentId   String     @map("student_id") @db.Uuid
  amount      Int
  type        CoinTxType
  referenceId String?    @map("reference_id") @db.Uuid
  description String?
  createdAt   DateTime   @default(now()) @map("created_at")

  student StudentProfile @relation("CoinTxStudent", fields: [studentId], references: [id], onDelete: Cascade, map: "fk_coin_tx_student")
  coin    StudentCoin    @relation("CoinTxCoin", fields: [studentId], references: [studentId], onDelete: Cascade, map: "fk_coin_tx_coin")

  @@index([studentId])
  @@index([createdAt])
  @@map("coin_transactions")
}

model Avatar {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  imageUrl    String?  @map("image_url")
  imageKey    String?  @map("image_key")
  price       Int
  isPublished Boolean  @default(true) @map("is_published")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  ownedBy StudentAvatar[]

  @@map("avatars")
}

model StudentAvatar {
  id          String   @id @default(uuid()) @db.Uuid
  studentId   String   @map("student_id") @db.Uuid
  avatarId    String   @map("avatar_id") @db.Uuid
  isActive    Boolean  @default(false) @map("is_active")
  purchasedAt DateTime @default(now()) @map("purchased_at")

  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade, map: "fk_savatar_student")
  avatar  Avatar         @relation(fields: [avatarId], references: [id], onDelete: Cascade, map: "fk_savatar_avatar")

  @@unique([studentId, avatarId])
  @@index([studentId])
  @@map("student_avatars")
}

model Frame {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  imageUrl    String?  @map("image_url")
  cssStyle    String?  @map("css_style")
  price       Int      @default(250)
  isPublished Boolean  @default(true) @map("is_published")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  students StudentFrame[]

  @@map("frames")
}

model StudentFrame {
  id          String   @id @default(uuid()) @db.Uuid
  studentId   String   @map("student_id") @db.Uuid
  frameId     String   @map("frame_id") @db.Uuid
  isActive    Boolean  @default(false) @map("is_active")
  purchasedAt DateTime @default(now()) @map("purchased_at")

  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade, map: "fk_sframe_student")
  frame   Frame          @relation(fields: [frameId], references: [id], onDelete: Cascade, map: "fk_sframe_frame")

  @@unique([studentId, frameId])
  @@index([studentId])
  @@map("student_frames")
}

// ==============================
// Q&A FEATURE (course-scoped)
// ==============================

model CourseQuestion {
  id          String         @id @default(uuid()) @db.Uuid
  courseId    String         @map("course_id") @db.Uuid
  studentId   String         @map("student_id") @db.Uuid
  content     String         @db.Text
  imageUrl    String?        @map("image_url")
  status      QuestionStatus @default(OPEN)
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  course      Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student     StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  replies     QAReply[]

  @@index([courseId])
  @@index([studentId])
  @@index([status])
  @@map("course_questions")
}

model QAReply {
  id          String    @id @default(uuid()) @db.Uuid
  questionId  String    @map("question_id") @db.Uuid
  authorId    String    @map("author_id") @db.Uuid
  parentId    String?   @map("parent_id") @db.Uuid
  content     String    @db.Text
  imageUrl    String?   @map("image_url")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  question    CourseQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  author      User           @relation("QARepliesByUser", fields: [authorId], references: [id], onDelete: Cascade)
  parent      QAReply?       @relation("ReplyThread", fields: [parentId], references: [id], onDelete: Cascade)
  children    QAReply[]      @relation("ReplyThread")

  @@index([questionId])
  @@index([parentId])
  @@map("qa_replies")
}

// ==============================
// SUMMARIES FEATURE
// ==============================

model Summary {
  id              String        @id @default(uuid()) @db.Uuid
  courseId        String        @map("course_id") @db.Uuid
  studentId       String        @map("student_id") @db.Uuid
  title           String
  description     String        @db.Text
  videoUrl        String?       @map("video_url")
  images          String[]      @default([]) // array of image URLs
  status          SummaryStatus @default(PENDING)
  rejectionReason String?       @map("rejection_reason")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  approvedAt      DateTime?     @map("approved_at")
  approvedById    String?       @map("approved_by_id") @db.Uuid

  course          Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student         StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  approvedBy      User?         @relation("SummariesApprovedBy", fields: [approvedById], references: [id])
  comments        SummaryComment[]

  @@index([courseId, status])
  @@index([studentId])
  @@map("summaries")
}

model SummaryComment {
  id          String    @id @default(uuid()) @db.Uuid
  summaryId   String    @map("summary_id") @db.Uuid
  authorId    String    @map("author_id") @db.Uuid
  parentId    String?   @map("parent_id") @db.Uuid
  content     String    @db.Text
  createdAt   DateTime  @default(now()) @map("created_at")

  summary     Summary          @relation(fields: [summaryId], references: [id], onDelete: Cascade)
  author      User             @relation("SummaryCommentsByUser", fields: [authorId], references: [id], onDelete: Cascade)
  parent      SummaryComment?  @relation("SummaryCommentThread", fields: [parentId], references: [id], onDelete: Cascade)
  children    SummaryComment[] @relation("SummaryCommentThread")

  @@index([summaryId])
  @@map("summary_comments")
}

// ==============================
// SHARED: REACTIONS (polymorphic)
// ==============================

model Reaction {
  id          String              @id @default(uuid()) @db.Uuid
  userId      String              @map("user_id") @db.Uuid
  targetType  ReactionTargetType  @map("target_type")
  targetId    String              @map("target_id") @db.Uuid
  type        ReactionType
  createdAt   DateTime            @default(now()) @map("created_at")

  user        User                @relation("ReactionsByUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, targetType, targetId])
  @@index([targetType, targetId])
  @@map("reactions")
}

// ==============================
// WEEKLY STUDENT PERFORMANCE SNAPSHOT
// ==============================

model WeeklyStudentReport {
  id            String   @id @default(uuid()) @db.Uuid
  studentId     String   @map("student_id") @db.Uuid
  courseId      String?  @map("course_id") @db.Uuid // null = overall (all courses)
  weekStartDate DateTime @map("week_start_date")
  weekEndDate   DateTime @map("week_end_date")
  generatedAt   DateTime @default(now()) @map("generated_at")
  data          Json     // full PeriodicReportData payload (snapshotted)

  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course  Course?       @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([studentId, courseId, weekStartDate])
  @@index([studentId, weekStartDate])
  @@map("weekly_student_reports")
}
