# Copy this file to .env. Never commit a real .env file or any production secret.
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/education_platform?schema=public"
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
JWT_ACCESS_SECRET=replace_with_a_long_random_value
JWT_REFRESH_SECRET=replace_with_a_different_long_random_value

# Local for development. Use s3 for Cloudflare R2, AWS S3, or another S3-compatible store.
STORAGE_DRIVER=local
AWS_REGION=auto
AWS_ENDPOINT=https://YOUR_CLOUDFLARE_ACCOUNT_ID.r2.cloudflarestorage.com
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=elearning-media
# Keep private video delivery signed by using the R2 endpoint + bucket path.
AWS_S3_PUBLIC_URL=https://YOUR_CLOUDFLARE_ACCOUNT_ID.r2.cloudflarestorage.com/elearning-media

# Only image/* files use Cloudinary. Videos and documents stay in the S3/R2 bucket.
CLOUDINARY_ENABLED=false
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=elearning
# Falls back to the running backend's /uploads folder only when Cloudinary quota is exhausted.
CLOUDINARY_FALLBACK_TO_LOCAL=true
STORAGE_BASE_URL=http://localhost:3000/uploads


DATABASE_URL="postgresql://postgres:postgres@localhost:5432/education_platform?schema=public"
